# Token that the Windows app and the web file-manager use to authenticate.
# Generate a long random value, e.g.:  openssl rand -hex 32
BACKUP_TOKEN=change-me-to-a-long-random-string

# Where uploaded backups are stored. On Railway this MUST point at a mounted
# Volume, otherwise every redeploy wipes your backups.
DATA_DIR=/data

# How many backups to keep on the server. The 11th upload deletes the oldest.
MAX_BACKUPS=10

# Port. Railway injects PORT automatically; 3000 is the local default.
PORT=3000
